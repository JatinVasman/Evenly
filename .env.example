# Environment Configuration for Evenly (Template)

# Local SQLite Database (Default for local development)
DATABASE_URL="file:./dev.db"

# Production Turso / libSQL Configuration (Configure when deploying to production)
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# App & Auth Secrets
APP_SECRET="replace_with_a_secure_random_string_in_production"
APP_URL="http://localhost:3000"
